#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  script_path="$(readlink -f -- "${script_path}")"
fi
script_dir="$(cd -- "$(dirname -- "${script_path}")" && pwd)"

config_dir="${CLIPBOARD_UTILS_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/clipboard-utils}"
systemd_user_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
service_file="${systemd_user_dir}/hclip.service"
env_file="${config_dir}/hclip.env"
default_port="${HCLIP_PORT:-23143}"
default_bind="${HCLIP_BIND:-127.0.0.1}"

usage() {
  cat <<USAGE
Usage:
  hclip-service install [--bind HOST] [PORT]
  hclip-service uninstall
  hclip-service start|stop|restart|status|enable|disable
  hclip-service daemon-reload

Installs a user-level systemd service at:
  ${service_file}

Environment file:
  ${env_file}
USAGE
}

require_systemctl() {
  if ! command -v systemctl >/dev/null 2>&1; then
    echo "hclip-service: systemctl is required." >&2
    exit 1
  fi
}

systemctl_user() {
  require_systemctl
  systemctl --user "$@"
}

write_env_file() {
  local bind_host="$1"
  local port="$2"
  local tmp_file

  mkdir -p "${config_dir}"
  tmp_file="$(mktemp "${config_dir}/hclip.env.XXXXXX")"
  chmod 600 "${tmp_file}" 2>/dev/null || true

  {
    printf 'HCLIP_BIND=%q\n' "${bind_host}"
    printf 'HCLIP_PORT=%q\n' "${port}"
    printf 'HCLIP_STATE_DIR=%q\n' "${HCLIP_STATE_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/clipboard-utils/hclip}"
  } >"${tmp_file}"

  mv "${tmp_file}" "${env_file}"
}

write_service_file() {
  local tmp_file

  mkdir -p "${systemd_user_dir}"
  tmp_file="$(mktemp "${systemd_user_dir}/hclip.service.XXXXXX")"

  {
    printf '%s\n' '[Unit]'
    printf '%s\n' 'Description=hclip clipboard receiver'
    printf '\n'
    printf '%s\n' '[Service]'
    printf '%s\n' 'Type=simple'
    printf 'EnvironmentFile=%s\n' "${env_file}"
    printf 'ExecStart=%s/hclip-start --foreground\n' "${script_dir}"
    printf '%s\n' 'Restart=on-failure'
    printf '%s\n' 'RestartSec=2'
    printf '\n'
    printf '%s\n' '[Install]'
    printf '%s\n' 'WantedBy=default.target'
  } >"${tmp_file}"

  mv "${tmp_file}" "${service_file}"
}

install_service() {
  local bind_host="${default_bind}"
  local port="${default_port}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --bind)
        bind_host="${2:?--bind requires a host}"
        shift 2
        ;;
      *)
        if [[ "$1" =~ ^[0-9]+$ ]]; then
          port="$1"
          shift
        else
          echo "hclip-service: unexpected argument: $1" >&2
          exit 2
        fi
        ;;
    esac
  done

  if [[ ! "${port}" =~ ^[0-9]+$ ]]; then
    echo "hclip-service: port must be numeric." >&2
    exit 2
  fi

  write_env_file "${bind_host}" "${port}"
  write_service_file
  systemctl_user daemon-reload
  echo "hclip-service: installed ${service_file}"
  echo "hclip-service: bind ${bind_host}"
  echo "hclip-service: port ${port}"
}

uninstall_service() {
  if [[ -f "${service_file}" ]]; then
    systemctl_user disable --now hclip.service >/dev/null 2>&1 || true
    rm -f "${service_file}"
    systemctl_user daemon-reload
    echo "hclip-service: removed ${service_file}"
  else
    echo "hclip-service: service is not installed"
  fi
}

case "${1:-}" in
  install)
    shift
    install_service "$@"
    ;;
  uninstall)
    uninstall_service
    ;;
  start|stop|restart|status|enable|disable)
    command_name="$1"
    shift
    systemctl_user "${command_name}" hclip.service "$@"
    ;;
  daemon-reload)
    systemctl_user daemon-reload
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "hclip-service: unknown command '${1:-}'." >&2
    usage >&2
    exit 2
    ;;
esac
