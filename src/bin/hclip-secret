#!/usr/bin/env bash
set -euo pipefail

state_dir="${HCLIP_STATE_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/clipboard-utils/hclip}"
token_file="${state_dir}/token"

usage() {
  cat <<USAGE
Usage:
  hclip-secret generate
  hclip-secret rotate
  hclip-secret show
  hclip-secret path

Environment:
  HCLIP_STATE_DIR    hclip state directory. Defaults to ~/.local/state/clipboard-utils/hclip.
USAGE
}

generate_secret_value() {
  if ! command -v openssl >/dev/null 2>&1; then
    echo "hclip-secret: openssl is required to generate secrets." >&2
    exit 1
  fi

  openssl rand -hex 32
}

ensure_secret() {
  mkdir -p "${state_dir}"

  if [[ -s "${token_file}" ]]; then
    echo "hclip-secret: secret already exists at ${token_file}"
    return 0
  fi

  umask 077
  generate_secret_value >"${token_file}"
  chmod 600 "${token_file}" 2>/dev/null || true
  echo "hclip-secret: generated secret at ${token_file}"
}

rotate_secret() {
  mkdir -p "${state_dir}"

  umask 077
  generate_secret_value >"${token_file}"
  chmod 600 "${token_file}" 2>/dev/null || true
  echo "hclip-secret: rotated secret at ${token_file}"
}

show_secret() {
  if [[ ! -s "${token_file}" ]]; then
    echo "hclip-secret: secret does not exist at ${token_file}" >&2
    exit 1
  fi

  cat "${token_file}"
}

case "${1:-}" in
  generate)
    ensure_secret
    ;;
  rotate)
    rotate_secret
    ;;
  show)
    show_secret
    ;;
  path)
    printf '%s\n' "${token_file}"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "hclip-secret: unknown command '${1:-}'." >&2
    usage >&2
    exit 2
    ;;
esac
