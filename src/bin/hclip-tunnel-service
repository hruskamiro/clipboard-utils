#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  script_path="$(readlink -f -- "${script_path}")"
fi
script_dir="$(cd -- "$(dirname -- "${script_path}")" && pwd)"

config_dir="${CLIPBOARD_UTILS_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/clipboard-utils}"
config_file="${CLIPBOARD_UTILS_CONFIG_FILE:-${config_dir}/config}"
state_dir="${HCLIP_STATE_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/clipboard-utils/hclip}"
systemd_user_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
service_file="${systemd_user_dir}/hclip-tunnel.service"
env_file="${config_dir}/hclip-tunnel.env"

usage() {
  cat <<USAGE
Usage:
  hclip-tunnel-service install
  hclip-tunnel-service uninstall
  hclip-tunnel-service start|stop|restart|status|enable|disable
  hclip-tunnel-service daemon-reload
  hclip-tunnel-service check

Installs a user-level systemd service at:
  ${service_file}

Environment file:
  ${env_file}

The tunnel service requires non-interactive SSH authentication.
USAGE
}

report_ok() {
  printf '  [ok]   %s\n' "$1"
}

report_warn() {
  printf '  [warn] %s\n' "$1"
  CHECK_WARNINGS=$((CHECK_WARNINGS + 1))
}

report_fail() {
  printf '  [miss] %s\n' "$1"
  CHECK_FAILURES=$((CHECK_FAILURES + 1))
}

require_systemctl() {
  if ! command -v systemctl >/dev/null 2>&1; then
    echo "hclip-tunnel-service: systemctl is required." >&2
    exit 1
  fi
}

systemctl_user() {
  require_systemctl
  systemctl --user "$@"
}

load_config() {
  if [[ ! -f "${config_file}" ]]; then
    return 1
  fi

  # shellcheck source=/dev/null
  source "${config_file}"
}

resolve_tunnel_config() {
  tunnel_host="${HCLIP_TUNNEL_HOST:-}"
  tunnel_local_port="${HCLIP_TUNNEL_LOCAL_PORT:-${HCLIP_PORT:-23143}}"
  tunnel_remote_host="${HCLIP_TUNNEL_REMOTE_HOST:-127.0.0.1}"
  tunnel_remote_port="${HCLIP_TUNNEL_REMOTE_PORT:-${HCLIP_PORT:-23143}}"
}

write_env_file() {
  local tmp_file

  mkdir -p "${config_dir}"
  tmp_file="$(mktemp "${config_dir}/hclip-tunnel.env.XXXXXX")"
  chmod 600 "${tmp_file}" 2>/dev/null || true

  {
    printf 'CLIPBOARD_UTILS_CONFIG_FILE=%q\n' "${config_file}"
    printf 'HCLIP_STATE_DIR=%q\n' "${state_dir}"
  } >"${tmp_file}"

  mv "${tmp_file}" "${env_file}"
}

write_service_file() {
  local tmp_file

  mkdir -p "${systemd_user_dir}"
  tmp_file="$(mktemp "${systemd_user_dir}/hclip-tunnel.service.XXXXXX")"

  {
    printf '%s\n' '[Unit]'
    printf '%s\n' 'Description=hclip SSH tunnel sender'
    printf '%s\n' 'After=network-online.target'
    printf '%s\n' 'Wants=network-online.target'
    printf '\n'
    printf '%s\n' '[Service]'
    printf '%s\n' 'Type=simple'
    printf 'EnvironmentFile=%s\n' "${env_file}"
    printf 'ExecStart=%s/hclip-tunnel start --foreground\n' "${script_dir}"
    printf '%s\n' 'Restart=on-failure'
    printf '%s\n' 'RestartSec=2'
    printf '\n'
    printf '%s\n' '[Install]'
    printf '%s\n' 'WantedBy=default.target'
  } >"${tmp_file}"

  mv "${tmp_file}" "${service_file}"
}

install_service() {
  write_env_file
  write_service_file
  systemctl_user daemon-reload
  echo "hclip-tunnel-service: installed ${service_file}"
  echo "hclip-tunnel-service: run 'hclip-tunnel-service check' before enabling"
}

uninstall_service() {
  if [[ -f "${service_file}" ]]; then
    systemctl_user disable --now hclip-tunnel.service >/dev/null 2>&1 || true
    rm -f "${service_file}"
    systemctl_user daemon-reload
    echo "hclip-tunnel-service: removed ${service_file}"
  else
    echo "hclip-tunnel-service: service is not installed"
  fi
}

check_tunnel_service() {
  local existing_tunnel=0

  CHECK_FAILURES=0
  CHECK_WARNINGS=0

  echo "hclip-tunnel-service check"
  echo "Config file: ${config_file}"
  echo "Service file: ${service_file}"
  echo "Environment file: ${env_file}"
  echo

  if load_config; then
    report_ok "config exists"
  else
    report_fail "config not found; run 'co remote import hclip-remote.conf'"
  fi

  resolve_tunnel_config

  if [[ -n "${tunnel_host}" ]]; then
    report_ok "tunnel host: ${tunnel_host}"
  else
    report_fail "HCLIP_TUNNEL_HOST is missing; import an SSH-mode hclip remote config"
  fi

  if [[ "${tunnel_local_port}" =~ ^[0-9]+$ && "${tunnel_remote_port}" =~ ^[0-9]+$ ]]; then
    report_ok "tunnel ports: ${tunnel_local_port} -> ${tunnel_remote_host}:${tunnel_remote_port}"
  else
    report_fail "tunnel ports must be numeric"
  fi

  if command -v ssh >/dev/null 2>&1; then
    report_ok "ssh: $(command -v ssh)"
  else
    report_fail "ssh is required"
  fi

  if command -v systemctl >/dev/null 2>&1; then
    report_ok "systemctl: $(command -v systemctl)"
    if systemctl --user show-environment >/dev/null 2>&1; then
      report_ok "systemctl --user is available"
    else
      report_fail "systemctl --user is not available in this session"
    fi
  else
    report_fail "systemctl is required"
  fi

  if [[ -f "${service_file}" ]]; then
    report_ok "service file exists"
  else
    report_warn "service is not installed yet"
  fi

  if [[ -f "${env_file}" ]]; then
    report_ok "service environment file exists"
  else
    report_warn "service environment file is not installed yet"
  fi

  if "${script_dir}/hclip-tunnel" status >/dev/null 2>&1; then
    existing_tunnel=1
    report_ok "managed tunnel is already running"
  fi

  if [[ -n "${tunnel_host}" && "$(command -v ssh || true)" ]]; then
    report_ok "SSH forwarding probe will verify non-interactive authentication"
  fi

  if [[ "${existing_tunnel}" -eq 0 && -n "${tunnel_host}" && "${tunnel_local_port}" =~ ^[0-9]+$ && "${tunnel_remote_port}" =~ ^[0-9]+$ && "$(command -v ssh || true)" ]]; then
    if timeout 8s ssh -N \
      -o BatchMode=yes \
      -o ConnectTimeout=5 \
      -o ExitOnForwardFailure=yes \
      -L "${tunnel_local_port}:${tunnel_remote_host}:${tunnel_remote_port}" \
      "${tunnel_host}" >/dev/null 2>&1; then
      report_warn "temporary tunnel command exited unexpectedly"
    else
      case "$?" in
        124)
          report_ok "SSH forward can be established"
          ;;
        *)
          report_fail "SSH forward could not be established; check auth, host, ports, or local port conflicts"
          ;;
      esac
    fi
  fi

  echo
  if [[ "${CHECK_FAILURES}" -eq 0 ]]; then
    echo "Result: ok"
  else
    echo "Result: ${CHECK_FAILURES} problem(s)"
  fi
  if [[ "${CHECK_WARNINGS}" -gt 0 ]]; then
    echo "Warnings: ${CHECK_WARNINGS}"
  fi

  return "${CHECK_FAILURES}"
}

case "${1:-}" in
  install)
    shift
    if [[ $# -gt 0 ]]; then
      echo "hclip-tunnel-service: unexpected argument: $1" >&2
      usage >&2
      exit 2
    fi
    install_service
    ;;
  uninstall)
    uninstall_service
    ;;
  start|stop|restart|status|enable|disable)
    command_name="$1"
    shift
    systemctl_user "${command_name}" hclip-tunnel.service "$@"
    ;;
  daemon-reload)
    systemctl_user daemon-reload
    ;;
  check|doctor)
    check_tunnel_service
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "hclip-tunnel-service: unknown command '${1:-}'." >&2
    usage >&2
    exit 2
    ;;
esac
