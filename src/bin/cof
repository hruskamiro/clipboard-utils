#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ $# -eq 0 ]]; then
  echo "usage: cof path [path...]" >&2
  exit 2
fi

cof_path() {
  local path="$1"

  if command -v realpath >/dev/null 2>&1 && realpath -m -- . >/dev/null 2>&1; then
    realpath -m -- "${path}"
    return
  fi

  case "${path}" in
    /*)
      printf '%s\n' "${path}"
      ;;
    *)
      printf '%s\n' "${PWD}/${path}"
      ;;
  esac
}

for path in "$@"; do
  cof_path "${path}"
done | "${script_dir}/co"
